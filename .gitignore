# ──────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# ──────────────────────────────────────────────
# Node / Frontend
# ──────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ──────────────────────────────────────────────
# Environment & Secrets
# ──────────────────────────────────────────────
.env
.env.*

# ──────────────────────────────────────────────
# Runtime / Generated Data
# ──────────────────────────────────────────────
*.db
*.csv
*.log
backend/chroma_db/

# ──────────────────────────────────────────────
# Data files (kept locally, not on GitHub)
# ──────────────────────────────────────────────
/data/*
*.pdf

# Committed exceptions: a small sample term dictionary and a four-sheet sample
# plan set ship with the repo so the app runs out of the box. The full
# third-party dictionary and any drawing from a real project stay ignored.
!/data/RSMeans_Illustrated_Construction_Dictionary/
/data/RSMeans_Illustrated_Construction_Dictionary/*
!/data/RSMeans_Illustrated_Construction_Dictionary/terms.json
# Sample retrieval corpus: project-authored text so the RAG vector tier has
# something to ingest on a fresh clone (see samples/README.md).
!/data/PlanRead-Sample-Glossary.pdf
!samples/
!samples/*.pdf

# ──────────────────────────────────────────────
# Test / Sample Images (kept locally)
# ──────────────────────────────────────────────
Images/

# ──────────────────────────────────────────────
# Documentation (local reference only, except the
# tracked Docker guide below)
# ──────────────────────────────────────────────
docs/
!docs/
docs/*
!docs/DOCKER.md

# ──────────────────────────────────────────────
# IDE & Editor
# ──────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml

# ──────────────────────────────────────────────
# OS
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db

# ──────────────────────────────────────────────
