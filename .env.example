# Copy this file to `.env` in the project root and fill in your values.
# `.env` is git-ignored; `.env.example` is the tracked template.

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
# Model used for the term explainer, Vision analysis and the agent chat.
OPENAI_MODEL=gpt-4o
# Optional: route all OpenAI calls through an OpenAI-compatible gateway
# (for example the TAMU AI Gateway). The base URL is passed through verbatim
# and only applied when OPENAI_PROVIDER is set to `custom`.
# OPENAI_PROVIDER=custom
# OPENAI_BASE_URL=https://gateway.api.tamu.ai/v1

# ── Google image search ──────────────────────────────────────
GOOGLE_CSE_API_KEY=your_google_cse_api_key_here
GOOGLE_CSE_CX=your_google_cse_cx_here

# ── Groq (optional fallback for text explanations) ───────────
GROQ_API_KEY=your_groq_api_key_here
